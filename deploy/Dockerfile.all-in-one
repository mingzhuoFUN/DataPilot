FROM node:22-bookworm-slim AS frontend-dependencies
WORKDIR /build
COPY demo/chat_v2/frontend/package.json demo/chat_v2/frontend/package-lock.json ./
RUN npm ci --ignore-scripts

FROM node:22-bookworm-slim AS frontend-builder
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_BACKEND_URL=/api \
    DATAPILOT_BACKEND_INTERNAL_URL=http://127.0.0.1:8200
COPY --from=frontend-dependencies /build/node_modules ./node_modules
COPY demo/chat_v2/frontend/ ./
RUN node scripts/setup-monaco.js && npm run build

FROM node:22-bookworm-slim AS node-runtime

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    MPLBACKEND=Agg \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    DATAPILOT_MODEL_PROVIDER=custom \
    DATAPILOT_MODEL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1 \
    DATAPILOT_MODEL_NAME=qwen-plus \
    DATAPILOT_ALLOW_CLIENT_PROVIDER_CONFIG=false \
    DATAPILOT_EXECUTION_MODE=local \
    DATAPILOT_WORKSPACE_BASE=/app/workspace \
    DATAPILOT_CORS_ORIGINS=* \
    NO_PROXY=localhost,127.0.0.1

COPY --from=node-runtime /usr/local/ /usr/local/

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      nginx \
      libgomp1 \
      fontconfig \
      fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY demo/chat_v2/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY demo/chat_v2/backend.py ./backend/backend.py
COPY demo/chat_v2/backend_app ./backend/backend_app
COPY demo/mock_vllm/start_mock_vllmserver.py ./mock/start_mock_vllmserver.py
COPY --from=frontend-builder /build/.next/standalone ./frontend
COPY --from=frontend-builder /build/.next/static ./frontend/.next/static
COPY --from=frontend-builder /build/public ./frontend/public
COPY deploy/nginx.single.conf /etc/nginx/conf.d/default.conf
COPY deploy/entrypoint.py ./entrypoint.py

RUN rm -f /etc/nginx/sites-enabled/default && mkdir -p /app/workspace

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=5 \
  CMD curl --fail http://127.0.0.1:8080/api/health || exit 1

CMD ["python", "/app/entrypoint.py"]
