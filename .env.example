# Port exposed by the all-in-one Docker Compose demo
DATAPILOT_PORT=8080

# Default requires no model weights or API key.
DATAPILOT_MODEL_PROVIDER=local
DATAPILOT_MODEL_API_BASE=http://mock:8000/v1
DATAPILOT_MODEL_NAME=DeepAnalyze-8B
DATAPILOT_MODEL_API_KEY=

# Set false for a hosted demo that must use only the server-side model settings.
DATAPILOT_ALLOW_CLIENT_PROVIDER_CONFIG=true
DATAPILOT_CORS_ORIGINS=*
DATAPILOT_MAX_UPLOAD_MB=50
DATAPILOT_ALLOW_EXTERNAL_PROXY=false
