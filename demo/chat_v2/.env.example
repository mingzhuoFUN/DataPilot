# DataPilot model provider: local, custom, or heywhale
DATAPILOT_MODEL_PROVIDER=local

# Local/mock default. Docker Compose overrides this to http://mock:8000/v1.
DATAPILOT_MODEL_API_BASE=http://localhost:8000/v1
DATAPILOT_MODEL_NAME=DeepAnalyze-8B

# Keep secrets server-side for a hosted deployment. Never commit a real key.
DATAPILOT_MODEL_API_KEY=

# true: users may enter provider settings in the WebUI (BYOK mode)
# false: the backend always uses the server-side values above
DATAPILOT_ALLOW_CLIENT_PROVIDER_CONFIG=true

# Comma-separated browser origins allowed to call the backend directly.
DATAPILOT_CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
DATAPILOT_MAX_UPLOAD_MB=50
DATAPILOT_ALLOW_EXTERNAL_PROXY=false

# Code execution mode: local or docker
DATAPILOT_EXECUTION_MODE=local
DATAPILOT_EXECUTION_TIMEOUT_SEC=120

# Workspace and service settings
DATAPILOT_WORKSPACE_BASE=workspace
DATAPILOT_BACKEND_HOST=0.0.0.0
DATAPILOT_BACKEND_PORT=8200

# Docker execution settings. Build the image before selecting docker mode:
# docker build -t datapilot-exec:latest -f Dockerfile.exec .
DATAPILOT_DOCKER_IMAGE=datapilot-exec:latest
DATAPILOT_DOCKER_CONTAINER_NAME=datapilot-exec
DATAPILOT_DOCKER_SESSION_IDLE_TTL_SEC=1800
DATAPILOT_DOCKER_WORKSPACE_DIR=/workspace
DATAPILOT_DOCKER_PYTHON_BIN=python
DATAPILOT_DOCKER_STOP_ON_SHUTDOWN=true

# Optional PDF settings
# DATAPILOT_PDF_CJK_MAINFONT=SimHei
# DATAPILOT_PDF_AUTO_DOWNLOAD_PANDOC=true
# DATAPILOT_PDF_PANDOC_CACHE_DIR=workspace/.tools/pandoc
